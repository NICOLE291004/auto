# Copia este archivo a .env.local y llena los valores.

# URL pública del sitio (sitemap, canonical, JSON-LD). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# WhatsApp del negocio, formato internacional sin "+" ni espacios (México: 52 + 10 dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=526621234567

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: solo servidor. Nunca la pongas en el navegador ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Fase 3 (todavía no se usan) ----
# ANTHROPIC_API_KEY=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
